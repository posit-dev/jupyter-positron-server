# syntax=docker/dockerfile:1
# Single-user Positron session image for Zero to JupyterHub (Kubernetes).
#
# Holds NO license. The license arrives as a mounted Kubernetes Secret at runtime
# (see values.yaml), so it never lands in an image layer or a registry.
#
# There is no custom hub image in this deployment: nothing Positron-related runs
# on the Hub, so the chart's stock hub image is used unchanged.
ARG BASE_IMAGE=quay.io/jupyter/base-notebook:latest
FROM ${BASE_IMAGE}

# jupyter-positron-server 0.0.6 and Positron 2026.09.0+ read the license file
# directly from the activation directory.
ARG POSITRON_VERSION=2026.09.0-256
ARG POSITRON_ARCH=x64
ARG POSITRON_SERVER_PKG="jupyter-positron-server==0.0.6"

ENV POSITRON_SERVER_DIR=/opt/positron-server

USER root

# curl for the tarball download (not guaranteed present in the base image).
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Positron Server. The CDN path segment differs from the download filename suffix
# (x64 -> x86_64, arm64 -> arm64), so derive it here.
RUN set -eux; \
    case "${POSITRON_ARCH}" in \
      x64)   cdn_arch=x86_64 ;; \
      arm64) cdn_arch=arm64 ;; \
      *)     cdn_arch="${POSITRON_ARCH}" ;; \
    esac; \
    mkdir -p "${POSITRON_SERVER_DIR}"; \
    curl -fL "https://cdn.posit.co/positron/releases/server/${cdn_arch}/positron-server-linux-${POSITRON_ARCH}-${POSITRON_VERSION}.tar.gz" \
      -o /tmp/positron-server.tar.gz; \
    tar -xzf /tmp/positron-server.tar.gz -C "${POSITRON_SERVER_DIR}" --strip-components=1; \
    rm -f /tmp/positron-server.tar.gz

# Proxy extension + Positron launcher tile. jupyter-server-proxy is a dependency
# of jupyter-positron-server; enable it as a server extension so the tile appears.
#
# jupyterhub-singleuser ships with the base image and must be compatible with the
# Hub's JupyterHub version (chart 4.4.1 ships JupyterHub 5.5.1). If user servers
# fail to spawn, pin it here to match:
#   RUN pip install --no-cache-dir 'jupyterhub==5.5.1'
RUN pip install --no-cache-dir "${POSITRON_SERVER_PKG}" && \
    jupyter server extension enable --sys-prefix jupyter_server_proxy

# positron-server on PATH for the session. Set here in the image rather than via
# singleuser.extraEnv: overriding PATH from the spawner drops the base image's
# conda entries and breaks jupyterhub-singleuser.
ENV PATH="${POSITRON_SERVER_DIR}/bin:${PATH}"

USER ${NB_UID}
